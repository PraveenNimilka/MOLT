{
  "schema_version": 1,
  "run_name": "smoke-cpu",
  "seed": 1337,
  "artifacts_dir": "artifacts/runs",
  "telemetry_interval_seconds": 0.1,
  "data": {
    "kind": "synthetic",
    "prepared_dir": "data/prepared/smoke",
    "train_bytes": 20000,
    "validation_bytes": 4000,
    "context_length": 16,
    "vocab_size": 256
  },
  "model": {
    "n_layers": 2,
    "d_model": 64,
    "n_heads": 4,
    "mlp_ratio": 4,
    "activation_checkpointing": false,
    "parameter_dtype": "float32"
  },
  "training": {
    "device": "cpu",
    "precision": "float32",
    "optimizer": "adamw",
    "learning_rate": 0.001,
    "weight_decay": 0.01,
    "micro_batch_size": 2,
    "gradient_accumulation": 1,
    "max_steps": 4,
    "eval_interval": 2,
    "eval_batches": 2,
    "checkpoint_interval": 2,
    "save_final_checkpoint": true,
    "gradient_clip": 1.0
  }
}
