{
  "mode": "pretrain",
  "data": {
    "path": "data/prepared/smoke/train.bin",
    "validation_path": "data/prepared/smoke/validation.bin",
    "context_length": 512,
    "storage_dtype": "uint8",
    "sequential": true,
    "packing": "contiguous"
  },
  "model": {
    "vocab_size": 8192,
    "context_length": 512,
    "layers": 8,
    "width": 640,
    "heads": 10,
    "hidden_width": 2560
  },
  "stream": {
    "device": "cuda",
    "compute_dtype": "bfloat16",
    "quant_block_size": 64,
    "lora_rank": 8,
    "lora_alpha": 16.0,
    "double_buffer": false,
    "pin_host_memory": true
  },
  "batch_size": 24,
  "gradient_accumulation": 1,
  "max_steps": 100,
  "learning_rate": 0.0004,
  "seed": 1337,
  "artifacts_dir": "artifacts/molt-stream/runs"
}
