{
  "mode": "pretrain",
  "data": {
    "path": "${MOLT_DATA_ROOT}/custom/data/prepared/train.bin",
    "validation_path": "${MOLT_DATA_ROOT}/custom/data/prepared/validation.bin",
    "context_length": 512,
    "storage_dtype": "int32",
    "sequential": true,
    "packing": "contiguous"
  },
  "model": {
    "vocab_size": 8192,
    "context_length": 512,
    "layers": 10,
    "width": 640,
    "heads": 10,
    "hidden_width": 2560
  },
  "stream": {
    "device": "cuda",
    "compute_dtype": "bfloat16",
    "quant_block_size": 64,
    "lora_rank": 8,
    "lora_alpha": 16.0,
    "double_buffer": false,
    "bundle_size": 4,
    "cuda_graphs": false,
    "pin_host_memory": true
  },
  "batch_size": 24,
  "gradient_accumulation": 2,
  "max_steps": 2500,
  "learning_rate": 0.0004,
  "seed": 1337,
  "execution_backend": "compile-max-autotune-no-cudagraphs",
  "thermal_target_c": 65.0,
  "thermal_abort_c": 86.0,
  "thermal_pause_seconds": 0.04,
  "artifacts_dir": "artifacts/molt-stream/runs"
}
