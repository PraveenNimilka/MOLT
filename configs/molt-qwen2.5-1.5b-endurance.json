{
  "mode": "qlora",
  "base_model": "${MOLT_QWEN_1P5B_MODEL}",
  "data": {
    "path": "${MOLT_DATA_ROOT}/qwen2.5-1.5b/train.bin",
    "validation_path": "${MOLT_DATA_ROOT}/qwen2.5-1.5b/validation.bin",
    "context_length": 512,
    "storage_dtype": "int32",
    "sequential": true,
    "packing": "contiguous"
  },
  "stream": {"device": "cuda", "compute_dtype": "bfloat16", "lora_rank": 8, "lora_alpha": 16.0, "lora_target_modules": "all-linear"},
  "batch_size": 1,
  "gradient_accumulation": 4,
  "max_steps": 2400,
  "evaluation_interval": 100,
  "learning_rate": 0.0002,
  "seed": 1337,
  "artifacts_dir": "molt-workspace/runs/qwen2.5-1.5b-endurance",
  "execution_backend": "eager",
  "activation_checkpointing": true,
  "qlora_autocast": true,
  "qlora_fused_optimizer": true,
  "qlora_checkpoint_stride": 8,
  "qlora_loss_chunk_size": 96,
  "qlora_loss_backend": "analytical",
  "qlora_precompute_head_gradient": true,
  "qlora_restore_tied_embedding_bf16": true,
  "qlora_frozen_rmsnorm_bf16": true,
  "qlora_validation_batches": 4,
  "qlora_validation_layer_guard": true,
  "thermal_target_c": 68.0,
  "thermal_microbatch_guard_c": 70.0,
  "thermal_abort_c": 72.0,
  "thermal_pause_seconds": 0.04,
  "thermal_control_mode": "reactive",
  "thermal_recovery_mode": "cool-and-continue",
  "thermal_recovery_c": 68.0,
  "thermal_max_recoveries": 3
}
