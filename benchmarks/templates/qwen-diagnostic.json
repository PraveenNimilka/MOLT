{
  "mode": "qlora",
  "base_model": "MODEL_PATH",
  "data": {
    "path": "TRAIN_DATA.bin",
    "validation_path": "VALIDATION_DATA.bin",
    "context_length": 1024,
    "storage_dtype": "int32",
    "sequential": true,
    "packing": "contiguous"
  },
  "stream": {
    "device": "cuda",
    "compute_dtype": "bfloat16",
    "lora_rank": 8,
    "lora_alpha": 16,
    "lora_target_modules": "all-linear",
    "cuda_graphs": true
  },
  "batch_size": 1,
  "gradient_accumulation": 1,
  "max_steps": 16,
  "evaluation_interval": 4,
  "learning_rate": 0.0002,
  "seed": 1337,
  "artifacts_dir": "molt-reproduction-runs",
  "execution_backend": "eager",
  "activation_checkpointing": true,
  "qlora_checkpoint_stride": 1,
  "qlora_joint_cuda_graph": false,
  "qlora_fused_optimizer": true,
  "qlora_autocast": true,
  "qlora_loss_chunk_size": 96,
  "qlora_loss_backend": "analytical",
  "qlora_precompute_head_gradient": true,
  "qlora_cache_frozen_head": true,
  "qlora_restore_tied_embedding_bf16": true,
  "qlora_frozen_rmsnorm_bf16": true,
  "qlora_validation_batches": 1,
  "thermal_target_c": 50,
  "thermal_microbatch_guard_c": 55,
  "thermal_abort_c": 72,
  "thermal_control_mode": "predictive-cruise",
  "thermal_lookahead_seconds": 3,
  "thermal_stability_band_c": 1.5,
  "thermal_power_target_watts": 25,
  "thermal_initial_pause_seconds": 1,
  "thermal_max_pause_seconds": 3,
  "thermal_recovery_mode": "stop"
}
